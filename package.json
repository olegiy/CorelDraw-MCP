{
  "name": "corel-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Local CorelDRAW 27 automation and VBA compilation over MCP",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:contracts": "npm run build && node scripts/check-contracts.mjs",
    "test:integration": "npm run build && node test/integration.mjs && node test/integration-recipes.mjs",
    "test:integration:observer": "npm run build && node test/integration-vba-observer.mjs",
    "install:codex": "node scripts/install-codex.mjs",
    "uninstall:codex": "node scripts/install-codex.mjs --uninstall"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
